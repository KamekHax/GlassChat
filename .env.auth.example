# Names and placeholders only. Never commit actual database, OAuth, or refresh-token secrets.
NODE_ENV=production
DATABASE_URL=postgresql://USER:REDACTED@HOST/DB?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:REDACTED@HOST/DB?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=5

# Render injects PORT. AUTH_PORT is the local-development fallback; production binds publicly.
AUTH_HOST=0.0.0.0
AUTH_PORT=3211
TRUST_PROXY=1

# The API allowlist uses the website's origin; email links use the GitHub Pages project path.
APP_ORIGIN=https://kamekhax.github.io
APP_BASE_URL=https://kamekhax.github.io/GlassChat

# Gmail API. Request only https://www.googleapis.com/auth/gmail.send.
# This is a sensitive OAuth scope; public use requires Google's OAuth verification.
# Refresh tokens issued while an external OAuth app is in Testing expire after 7 days.
AUTH_EMAIL_MODE=gmail-api
GMAIL_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=REPLACE_ME
GMAIL_OAUTH_REFRESH_TOKEN=REPLACE_ME
GMAIL_FROM=kamekfnbr@gmail.com
